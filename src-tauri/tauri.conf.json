{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meowcal Sub 2",
  "version": "0.1.0",
  "identifier": "com.meowcal.sub2",
  "build": {
    "frontendDist": "../src/meocosub2/overlay/static",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Meowcal Sub 2",
        "label": "main",
        "url": "http://127.0.0.1:8765/",
        "width": 1320,
        "height": 900,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "visible": true
      },
      {
        "title": "Select Capture Area",
        "label": "selector",
        "url": "selector.html",
        "fullscreen": true,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": true,
        "focusable": true,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "title": "",
        "label": "capture-hud",
        "url": "capture-hud.html",
        "width": 900,
        "height": 360,
        "x": 0,
        "y": 0,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "focusable": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
