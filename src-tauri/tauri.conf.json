{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meowcal Sub 2",
  "version": "0.1.0",
  "identifier": "com.meowcal.sub2",
  "build": {
    "frontendDist": "../src/meocosub2/overlay/static",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm --prefix ../src/meocosub2/overlay/ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Meowcal Sub 2",
        "label": "main",
        "url": "splash.html",
        "width": 1440,
        "height": 960,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": true
      },
      {
        "title": "Select Capture Area",
        "label": "selector",
        "url": "selector.html",
        "fullscreen": true,
        "transparent": true,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": true,
        "focusable": true,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "title": "Meowcal Subtitles",
        "label": "overlay",
        "url": "overlay.html",
        "width": 800,
        "height": 120,
        "transparent": true,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ],
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
