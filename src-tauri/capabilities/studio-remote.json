{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "studio-remote",
  "description": "Allow the loopback studio to control capture and its live session.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "studio-shell"
  ]
}
